{
  "query": {
    "bool": {
      "must": [
        {"terms": {"destination.port": [80, 443]}}
      ],
      "must_not": [
        {"wildcard": {"message": "*google.com*"}},        
        {"wildcard": {"message": "*maps.googleapis.com*"}},
        {"wildcard": {"message": "*fonts.googleapis.com*"}},
        {"wildcard": {"message": "*ajax.googleapis.com*"}},  
        {"wildcard": {"message": "safebrowsing.googleapis.com"}},        
        {"wildcard": {"message": "update.googleapis.com"}},
        {"wildcard": {"message": "*googleusercontent.com*"}},
        {"wildcard": {"message": "*doubleclick.net*"}},
        {"wildcard": {"message": "*msn.com*"}},
        {"wildcard": {"message": "*bing.com*"}},
        {"wildcard": {"message": "*clarity.ms*"}},
        {"wildcard": {"message": "*microsoft.com*"}},
        {"wildcard": {"message": "*microsoft.net*"}},
        {"wildcard": {"message": "*microsoftapp.net*"}},
        {"wildcard": {"message": "*microsoftonline.com*"}},
        {"wildcard": {"message": "*msedge.net*"}},
        {"wildcard": {"message": "*azureedge.net*"}},
        {"wildcard": {"message": "*live.com*"}},
        {"wildcard": {"message": "*office.com*"}},
        {"wildcard": {"message": "*windows.com*"}},
        {"wildcard": {"message": "*adobe.com*"}},
        {"wildcard": {"message": "*liveperson.net*"}},
        {"wildcard": {"message": "*lpsnmedia.net*"}},
        {"wildcard": {"message": "*linkedin.com*"}},
        {"wildcard": {"message": "*skype.com*"}},
        {"wildcard": {"message": "*nvidia.com*"}},
        {"wildcard": {"message": "*azure.com*"}},
        {"wildcard": {"message": "*yahoo.com*"}},
        {"wildcard": {"message": "*facebook.com*"}}
      ]
    }
  },
"aggs": {
  "domains": {
    "terms": {
      "script": {
        "source": "if (doc['message.keyword'].size() > 0) { def msg = doc['message.keyword'].value.toLowerCase(); def server_name_pattern = /\\\"server_name\\\":\\\"([^\\\"]+)\\\"/; def matcher = server_name_pattern.matcher(msg); if (matcher.find()) { return matcher.group(1); } def sni_pattern = /server_name:\\s*([^\\s,\\r\\n]+)/; def matcher2 = sni_pattern.matcher(msg); if (matcher2.find()) { return matcher2.group(1); } } return null;"
      },
      "size": 50,
      "min_doc_count": 1
    }
  },
  "direct_ip_connections": {
    "terms": {
      "script": {
        "source": "if (doc['message.keyword'].size() > 0) { def msg = doc['message.keyword'].value; if (!msg.contains('server_name') && doc.containsKey('destination.ip')) { return doc['destination.ip'].value; } } return null;"
      },
      "size": 30,
      "min_doc_count": 1
    }
  },
  "http_raw_ip_requests": {
    "filter": {
      "bool": {
        "must": [
          {"exists": {"field": "http.method"}},
          {"regexp": {"http.virtual_host": "[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+"}}
        ]
      }
    },
    "aggs": {
      "raw_ip_hosts": {
        "terms": {"field": "http.virtual_host", "size": 50, "order": {"_count": "desc"}},
        "aggs": {
          "uris": {
            "terms": {"field": "http.uri", "size": 20},
            "aggs": {
              "methods": {
                "terms": {"field": "http.method"}
              }
            }
          }
        }
      }
    }
  }  
},
"_source": ["message", "@timestamp", "source.ip", "destination.ip"],
"size": 0
}